DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional pool tuning: connections (default 10) and requests allowed to wait for one (default 1000).
DB_CONNECTION_LIMIT=
DB_QUEUE_LIMIT=

NEXT_PUBLIC_LINE_LIFF_ID=
NEXT_PUBLIC_REQUIRE_LINE=true
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=
APP_REQUIRE_LINE=true
APP_BASE_URL=https://gymnos234.com
ADMIN_ACCESS_KEY=
# Optional separate session signing secret (at least 32 random characters).
# Falls back to ADMIN_ACCESS_KEY. Rotating either active secret signs everyone out.
SESSION_SECRET=

# PromptPay QR for member payments (mobile 10 digits, tax ID 13 digits or e-wallet 15 digits).
# Leave empty to keep staff-confirmed payment requests without a QR.
PROMPTPAY_ID=
# Receiving account name shown to members under the QR.
PROMPTPAY_NAME=
# Transfer slips (financial records). Must be a persistent, backed-up path outside public/.
# Default: storage/payment-slips in the app directory.
SLIP_STORAGE_DIR=
# Also send payment notices as LINE OA push messages (uses the OA message quota).
LINE_PUSH_ENABLED=false
